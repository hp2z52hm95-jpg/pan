/* launcher.rc - Windows resources for PandoraLauncher.exe
 *
 *  - application manifest (comctl32 v6, DPI awareness, execution level)
 *  - the Pandora icon (extracted from PandoraTool.exe, so both apps match)
 *  - version information shown in Explorer / Task Manager
 *
 * Compile with:  rc launcher.rc            (MSVC)
 *                windres launcher.rc -O coff -o launcher.res.o   (MinGW)
 *                zig rc launcher.rc       (cross-compiling from Linux)
 */

#include "launcher.rc.h"

/* 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST */
1 24 "launcher.manifest"

/* Application icon (supplies all sizes present in the .ico). */
1 ICON "pandora.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Pandora Tool"
            VALUE "FileDescription",  "Pandora Tool launcher - passkey/password sign-in and updates"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PandoraLauncher"
            VALUE "OriginalFilename", "PandoraLauncher.exe"
            VALUE "ProductName",      "Pandora Launcher"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "LegalCopyright",   "Pandora Tool"
            VALUE "Comments",         "Signs the user in (password or Windows Hello passkey), applies signed updates, then starts PandoraTool.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
