# Pandora Passkey Server Configuration
# Copy this to .env and customize for your environment

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration
DB_PATH=./database/pandora.db

# WebAuthn Configuration
# Relying Party ID (usually your domain without protocol)
RP_ID=localhost
RP_NAME=Pandora Tool
RP_ORIGIN=http://localhost:3000

# Expected origin for WebAuthn (where your client app runs)
# For production: https://yourdomain.com
# For development: http://localhost:3000
WEBAUTHN_ORIGIN=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=another-secret-key-for-sessions
CHALLENGE_TIMEOUT_MS=300000

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
