/*
 * app.rc - PandoraLauncher.exe resources (icon, version info, manifest).
 *
 * The icon is the same one PandoraTool.exe uses (rebuilt from the extracted
 * resources by src/tools/make-icon.py), so the shortcut looks familiar.
 *
 * About privileges: the launcher runs with the user's own rights
 * (asInvoker). If the Pandora folder needs administrator rights, the launcher
 * notices the access denied while applying an update and offers to restart
 * itself with "runas". To always start elevated instead, change
 * requestedExecutionLevel in app.manifest to requireAdministrator.
 */
#include <winver.h>

"MAINICON" ICON "icon.ico"

1 24 "app.manifest"          /* RT_MANIFEST */

1 VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Pandora\0"
      VALUE "FileDescription",  "Pandora Launcher - sign in, update, start PandoraTool\0"
      VALUE "FileVersion",      "1.0.0.0\0"
      VALUE "InternalName",     "PandoraLauncher\0"
      VALUE "LegalCopyright",   "Pandora\0"
      VALUE "OriginalFilename", "PandoraLauncher.exe\0"
      VALUE "ProductName",      "Pandora Launcher\0"
      VALUE "ProductVersion",   "1.0.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
